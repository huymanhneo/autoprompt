{
  appId: "com.youtube.video.automation",
  productName: "YouTube Video Automation",
  directories: {
    output: "release"
  },
  files: [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  // Explicitly disable code signing globally
  forceCodeSigning: false,

  mac: {
    target: ["dmg", "zip"],
    category: "public.app-category.productivity",
    identity: null
  },

  win: {
    target: [
      {
        target: "nsis",
        arch: ["x64"]
      },
      {
        target: "portable",
        arch: ["x64"]
      }
    ],
    // Disable signing completely
    sign: null,
    verifyUpdateCodeSignature: false,
    signDlls: false,
    signAndEditExecutable: false
  },

  linux: {
    target: ["AppImage", "deb", "rpm"],
    category: "Utility"
  }
}
