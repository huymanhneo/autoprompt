# API Keys Configuration
# Copy this file to .env and fill in your API keys

# Google Gemini (Required for LLM)
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud TTS (Optional - can use Gemini key)
GOOGLE_TTS_API_KEY=your_google_tts_api_key_here

# ElevenLabs (Optional - for high-quality TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# FPT AI (Optional - Vietnamese TTS)
FPT_AI_API_KEY=your_fpt_api_key_here

# Viettel AI (Optional - Vietnamese TTS)
VIETTEL_AI_API_KEY=your_viettel_api_key_here

# OpenAI (Optional - for future support)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude (Optional - for future support)
CLAUDE_API_KEY=your_claude_api_key_here

# App Configuration
NODE_ENV=development
