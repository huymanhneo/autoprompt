      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [-1456, -480],
      "id": "c3282f39-f832-4c83-a9e0-15b8c1680d77",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "jsCode": "// =================================================================\n// CHỈNH SỬA SỐ Ở DÒNG DƯỚI ĐÂY\n// Đây là số lượng câu (subtitle block) trong mỗi file SRT được tách ra.\nconst soCauMoiLanGen = 25;\n// =================================================================\n\n// --- CÁC HÀM HỖ TRỢ XỬ LÝ THỜI GIAN ---\n\n/**\n * Chuyển đổi chuỗi thời gian SRT (HH:MM:SS,ms) thành milliseconds.\n * @param {string} timeString - Chuỗi thời gian như \"00:01:32,543\".\n * @returns {number} - Tổng số milliseconds.\n */\nfunction timeToMs(timeString) {\n  const parts = timeString.split(/:|,/);\n  const hours = parseInt(parts[0], 10);\n  const minutes = parseInt(parts[1], 10);\n  const seconds = parseInt(parts[2], 10);\n  const milliseconds = parseInt(parts[3], 10);\n  return (hours * 3600 + minutes * 60 + seconds) * 1000 + milliseconds;\n}\n\n/**\n * Chuyển đổi milliseconds thành chuỗi thời gian SRT (HH:MM:SS,ms).\n * @param {number} ms - Tổng số milliseconds.\n * @returns {string} - Chuỗi thời gian được định dạng.\n */\nfunction msToTime(ms) {\n  if (ms < 0) ms = 0; // Đảm bảo thời gian không bao giờ là số âm\n  \n  const hours = Math.floor(ms / 3600000);\n  ms %= 3600000;\n  const minutes = Math.floor(ms / 60000);\n  ms %= 60000;\n  const seconds = Math.floor(ms / 1000);\n  const milliseconds = ms % 1000;\n\n  return (\n    String(hours).padStart(2, '0') + ':' +\n    String(minutes).padStart(2, '0') + ':' +\n    String(seconds).padStart(2, '0') + ',' +\n    String(milliseconds).padStart(3, '0')\n  );\n}\n\n\n// --- LOGIC CHÍNH ---\n\nconst srtInput = items[0].json.output;\n\nif (!srtInput || typeof srtInput !== 'string') {\n  console.log(\"Không tìm thấy dữ liệu SRT hoặc định dạng không đúng.\");\n  return [];\n}\n\nconst tatCaCacCau = srtInput.split('\\n\\n').filter(block => block.trim() !== '');\nconst itemsKetQua = [];\n\n// Lặp qua mảng các câu và chia chúng thành các phần nhỏ hơn\nfor (let i = 0; i < tatCaCacCau.length; i += soCauMoiLanGen) {\n  const motPhanCuaCau = tatCaCacCau.slice(i, i + soCauMoiLanGen);\n\n  if (motPhanCuaCau.length === 0) {\n    continue; // Bỏ qua nếu đoạn rỗng\n  }\n\n  // 1. TÌM GIÁ TRỊ BAN ĐẦU\n  const firstBlock = motPhanCuaCau[0];\n  \n  // Lấy thời gian bắt đầu của câu đầu tiên để làm offset\n  const timeMatch = firstBlock.match(/(\\d{2}:\\d{2}:\\d{2},\\d{3}) -->/);\n  const firstStartTimeString = timeMatch ? timeMatch[1] : '00:00:00,000';\n  const offsetMs = timeToMs(firstStartTimeString);\n\n  // Lấy số thứ tự của câu đầu tiên để làm offset\n  const indexMatch = firstBlock.match(/^(\\d+)/);\n  const firstIndex = indexMatch ? parseInt(indexMatch[1], 10) : 1;\n\n  // 2. ĐIỀU CHỈNH LẠI THỜI GIAN VÀ SỐ THỨ TỰ CHO CẢ ĐOẠN\n  const chunkDaSua = motPhanCuaCau.map((block, localIndex) => {\n    const lines = block.split('\\n');\n    if (lines.length < 2) {\n      return block; // Trả về block gốc nếu không hợp lệ\n    }\n    \n    // Sửa số thứ tự\n    const originalIndexMatch = lines[0].match(/^(\\d+)/);\n    if (originalIndexMatch) {\n      const originalIndex = parseInt(originalIndexMatch[1], 10);\n      // Thay bằng số thứ tự mới: (chỉ số hiện tại - chỉ số đầu) + 1\n      // Hoặc đơn giản là chỉ số trong mảng con + 1\n      lines[0] = localIndex + 1;\n    }\n    \n    // Sửa thời gian\n    const timeLine = lines[1];\n    const match = timeLine.match(/(\\d{2}:\\d{2}:\\d{2},\\d{3}) --> (\\d{2}:\\d{2}:\\d{2},\\d{3})/);\n\n    if (match) {\n      const startTimeStr = match[1];\n      const endTimeStr = match[2];\n\n      // Chuyển đổi, trừ đi offset, và chuyển đổi lại\n      const newStartMs = timeToMs(startTimeStr) - offsetMs;\n      const newEndMs = timeToMs(endTimeStr) - offsetMs;\n\n      const newStartTimeStr = msToTime(newStartMs);\n      const newEndTimeStr = msToTime(newEndMs);\n      \n      // Cập nhật lại dòng thời gian\n      lines[1] = `${newStartTimeStr} --> ${newEndTimeStr}`;\n      return lines.join('\\n');\n    }\n    \n    return block; // Trả về block gốc nếu không tìm thấy thời gian\n  });\n\n  // 3. GHÉP CÁC CÂU ĐÃ SỬA VÀ THÊM VÀO KẾT QUẢ\n  const srtChunk = chunkDaSua.join('\\n\\n');\n  itemsKetQua.push({\n    json: {\n      output_srt: srtChunk\n    }\n  });\n}\n\n// 4. TRẢ VỀ KẾT QUẢ\nreturn itemsKetQua;"
      },
