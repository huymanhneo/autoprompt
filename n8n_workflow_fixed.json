        "command": "cd tmp/n8n/youtubehuymanh/ && \\\n# Kiểm tra file SRT tồn tại\nif [ ! -f \"output.srt\" ]; then echo \"ERROR: output.srt not found!\"; exit 1; fi && \\\n# Lấy đường dẫn tuyệt đối\nSRT_PATH=$(pwd)/output.srt && \\\n# Tạo merged voiceover\nfind . -maxdepth 1 -name \"*.mp3\" -not -name \"bgrmusic.mp3\" -printf \"file '%p'\\n\" | sort > mylist.txt && \\\nffmpeg -y -f concat -safe 0 -i mylist.txt -c copy merged_voiceover.mp3 && \\\n# Xử lý video với blur zone và subtitle\nffmpeg -y -i video_download.mp4 -i merged_voiceover.mp3 -stream_loop -1 -i bgrmusic.mp3 \\\n  -filter_complex \"\\\n    [0:v]eq=brightness=0.03:contrast=1.08:saturation=1.12,\\\n         hflip,\\\n         crop=iw*0.92:ih*0.92,\\\n         scale=iw:ih,\\\n         unsharp=5:5:0.8:5:5:0.0,\\\n         vignette=PI/5[v1];\\\n    [v1]split[main][blur];\\\n    [blur]crop=iw:180:0:ih-180,boxblur=15:5[blurred];\\\n    [main][blurred]overlay=0:H-180[v2];\\\n    [v2]subtitles='$SRT_PATH':force_style='FontName=Arial,FontSize=26,PrimaryColour=&H00FFFFFF,OutlineColour=&H00000000,Outline=2,Shadow=1,Bold=1,Alignment=2,MarginV=30',\\\n         setpts=0.98*PTS,\\\n         setsar=1[v];\\\n    [1:a]atempo=1.02,volume=1.0[voice];\\\n    [2:a]atempo=1.02,volume=0.45,bass=g=3[bg];\\\n    [voice][bg]amix=inputs=2:duration=first[a]\" \\\n  -map \"[v]\" -map \"[a]\" \\\n  -c:v libx264 -preset medium -crf 22 \\\n  -c:a aac -b:a 192k \\\n  -r 29.97 \\\n  -map_metadata -1 \\\n  -shortest final_video.mp4 && \\\nrm mylist.txt merged_voiceover.mp3"
      },
