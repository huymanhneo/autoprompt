        "jsonSchemaExample": "{\n  \"tinh_huong\": \"SHIPPER GIAO HÀNG BẰNG XE XỊN LÊN TOP TÌM KIẾM\",\n  \"caption\": \"Chỉ sau một đêm, anh shipper nghèo bỗng nổi tiếng khắp cõi mạng chỉ vì đi giao hàng bằng siêu xe.\",\n  \"hashtags\": \"#vdrama #phim #phimngan #phimtrungquoc #reviewphim\"\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [-352, -640],
      "id": "766e1c17-619c-4b54-b1dd-7ba78b35859e",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "jsCode": "// Ghép tất cả các chunks SRT đã dịch thành 1 file SRT hoàn chỉnh\nconst allChunks = [];\n\n// Lấy tất cả chunks từ loop\nfor (let i = 0; i < items.length; i++) {\n  const chunk = items[i].json.output_srt || items[i].json.text || '';\n  if (chunk && chunk.trim()) {\n    allChunks.push(chunk.trim());\n  }\n}\n\n// Ghép lại thành file SRT hoàn chỉnh\nconst fullSRT = allChunks.join('\\n\\n');\n\n// Đánh lại số thứ tự cho các subtitle blocks\nconst blocks = fullSRT.split('\\n\\n').filter(b => b.trim());\nconst renumbered = blocks.map((block, index) => {\n  const lines = block.split('\\n');\n  if (lines.length >= 2) {\n    lines[0] = String(index + 1); // Đánh lại số thứ tự\n    return lines.join('\\n');\n  }\n  return block;\n});\n\nconst finalSRT = renumbered.join('\\n\\n');\n\nreturn [{\n  json: {\n    merged_srt: finalSRT\n  }\n}];"
      },
